{
  "name": "Call Analysis - AssemblyAI + GPT + Bitrix24 (Webhook)",
  "nodes": [
    {
      "parameters": {
        "path": "call-bitrix-incoming",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Bitrix24 Call Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "bitrix-call-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-event-type",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "ONVOXIMPLANTCALLEND",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-call-end-event",
      "name": "Is Call End Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-call-id",
              "name": "call_id",
              "value": "={{ $json.body.data.CALL_ID }}",
              "type": "string"
            },
            {
              "id": "set-lead-id",
              "name": "lead_id",
              "value": "={{ $json.body.data.CRM_ENTITY_TYPE === 'LEAD' ? $json.body.data.CRM_ENTITY_ID : null }}",
              "type": "string"
            },
            {
              "id": "set-deal-id",
              "name": "deal_id",
              "value": "={{ $json.body.data.CRM_ENTITY_TYPE === 'DEAL' ? $json.body.data.CRM_ENTITY_ID : null }}",
              "type": "string"
            },
            {
              "id": "set-record-file-id",
              "name": "record_file_id",
              "value": "={{ $json.body.data.RECORD_FILE_ID }}",
              "type": "string"
            },
            {
              "id": "set-duration",
              "name": "duration",
              "value": "={{ $json.body.data.DURATION }}",
              "type": "number"
            },
            {
              "id": "set-call-date",
              "name": "call_date",
              "value": "={{ new Date().toISOString() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-webhook-data",
      "name": "Extract Webhook Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 200]
    },
    {
      "parameters": {
        "batchSize": 5,
        "options": {
          "reset": false
        }
      },
      "id": "limit-5-records",
      "name": "Limit to 5 Records",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [660, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-has-record",
              "leftValue": "={{ $json.record_file_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-record-id",
      "name": "Has Record File ID?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $credentials.bitrix24Webhook }}disk.file.get?id={{ $json.record_file_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpQueryAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "bitrix-get-file-info",
      "name": "Bitrix24 Get File Info",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 100],
      "credentials": {
        "httpQueryAuth": {
          "id": "BITRIX24_CREDENTIAL_ID",
          "name": "Bitrix24 Webhook"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.result.DOWNLOAD_URL }}",
        "authentication": "none",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "download-call-recording",
      "name": "Download Call Recording",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 100],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "operation": "upload",
        "bucketName": "call-recordings",
        "fileName": "={{ $('Extract Webhook Data').item.json.call_id }}.mp3",
        "options": {}
      },
      "id": "supabase-upload-file",
      "name": "Upload to Supabase Storage",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1540, 100],
      "credentials": {
        "supabaseApi": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-audio-url",
              "name": "audio_url",
              "value": "={{ $json.publicUrl }}",
              "type": "string"
            },
            {
              "id": "set-call-id-merge",
              "name": "call_id",
              "value": "={{ $('Extract Webhook Data').item.json.call_id }}",
              "type": "string"
            },
            {
              "id": "set-lead-id-merge",
              "name": "lead_id",
              "value": "={{ $('Extract Webhook Data').item.json.lead_id }}",
              "type": "string"
            },
            {
              "id": "set-deal-id-merge",
              "name": "deal_id",
              "value": "={{ $('Extract Webhook Data').item.json.deal_id }}",
              "type": "string"
            },
            {
              "id": "set-call-date-merge",
              "name": "call_date",
              "value": "={{ $('Extract Webhook Data').item.json.call_date }}",
              "type": "string"
            },
            {
              "id": "set-duration-merge",
              "name": "audio_duration_seconds",
              "value": "={{ $('Extract Webhook Data').item.json.duration }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "prepare-supabase-data",
      "name": "Prepare Supabase Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1760, 100]
    },
    {
      "parameters": {
        "operation": "insert",
        "tableId": "calls_analysis",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "call_id": "={{ $json.call_id }}",
            "lead_id": "={{ $json.lead_id }}",
            "deal_id": "={{ $json.deal_id }}",
            "call_date": "={{ $json.call_date }}",
            "audio_url": "={{ $json.audio_url }}",
            "audio_duration_seconds": "={{ $json.audio_duration_seconds }}",
            "transcription_status": "pending"
          }
        },
        "options": {
          "onConflict": {
            "columns": ["call_id"],
            "onConflictAction": "doNothing"
          }
        }
      },
      "id": "supabase-create-record",
      "name": "Create Call Record in Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1980, 100],
      "credentials": {
        "supabaseApi": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.assemblyai.com/v2/transcript",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"audio_url\": \"{{ $json.audio_url }}\",\n  \"speaker_labels\": true,\n  \"language_code\": \"ru\",\n  \"punctuate\": true,\n  \"format_text\": true\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "assemblyai-start",
      "name": "AssemblyAI Start Transcription",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, 100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ASSEMBLYAI_CREDENTIAL_ID",
          "name": "AssemblyAI API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "calls_analysis",
        "matchingColumns": ["call_id"],
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "assemblyai_transcript_id": "={{ $json.id }}",
            "transcription_status": "processing"
          }
        }
      },
      "id": "supabase-save-transcript-id",
      "name": "Save Transcript ID",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2420, 100],
      "credentials": {
        "supabaseApi": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "amount": 10,
        "unit": "seconds"
      },
      "id": "wait-polling",
      "name": "Wait 10s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2640, 100],
      "webhookId": "wait-polling-webhook"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.assemblyai.com/v2/transcript/{{ $('AssemblyAI Start Transcription').item.json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "id": "assemblyai-check-status",
      "name": "Check Transcription Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2860, 100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ASSEMBLYAI_CREDENTIAL_ID",
          "name": "AssemblyAI API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-completed",
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-transcription-completed",
      "name": "Transcription Completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [3080, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-error",
              "leftValue": "={{ $json.status }}",
              "rightValue": "error",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-transcription-error",
      "name": "Transcription Error?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [3300, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "calls_analysis",
        "matchingColumns": ["call_id"],
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "transcription_status": "failed",
            "error_message": "={{ $json.error }}"
          }
        }
      },
      "id": "supabase-set-failed",
      "name": "Set Status Failed",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [3520, 400],
      "credentials": {
        "supabaseApi": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-transcript-text",
              "name": "transcript_text",
              "value": "={{ $json.text }}",
              "type": "string"
            },
            {
              "id": "set-utterances",
              "name": "utterances",
              "value": "={{ $json.utterances }}",
              "type": "array"
            },
            {
              "id": "set-speakers",
              "name": "speakers_count",
              "value": "={{ [...new Set($json.utterances.map(u => u.speaker))].length }}",
              "type": "number"
            },
            {
              "id": "set-formatted-transcript",
              "name": "formatted_transcript",
              "value": "={{ $json.utterances.map(u => `Speaker ${u.speaker}: ${u.text}`).join('\\n\\n') }}",
              "type": "string"
            },
            {
              "id": "set-call-id-extract",
              "name": "call_id",
              "value": "={{ $('Prepare Supabase Data').item.json.call_id }}",
              "type": "string"
            },
            {
              "id": "set-lead-id-extract",
              "name": "lead_id",
              "value": "={{ $('Prepare Supabase Data').item.json.lead_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-extract-data",
      "name": "Extract Transcription Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [3300, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "calls_analysis",
        "matchingColumns": ["call_id"],
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "transcription_status": "completed",
            "transcript_raw": "={{ JSON.stringify($json) }}",
            "transcript": "={{ $json.formatted_transcript }}",
            "speakers_detected": "={{ $json.speakers_count }}"
          }
        }
      },
      "id": "supabase-save-raw-transcript",
      "name": "Save Raw Transcription",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [3520, 0],
      "credentials": {
        "supabaseApi": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Ты — профессиональный редактор текстовой транскрибации звонков компании по продаже металлопроката.\n\nТвоя задача:\n1. Исправить орфографические и грамматические ошибки.\n2. Убрать повторы слов, заикания, междометия (э-э-э, м-м-м).\n3. Привести текст в читаемый формат.\n4. ОБЯЗАТЕЛЬНО чётко разделить реплики:\n   - \"Менеджер:\" — всё, что говорит сотрудник компании (Speaker A обычно)\n   - \"Клиент:\" — всё, что говорит звонящий (Speaker B обычно)\n\nПример формата:\nМенеджер: Добрый день, меня зовут Алексей, компания Регион Сталь. Чем могу помочь?\nКлиент: Здравствуйте, мне нужна арматура 12 мм.\n\nИсходная транскрибация:\n{{ $json.formatted_transcript }}\n\nОтветь только очищенной транскрибацией, без комментариев.",
        "options": {
          "systemMessage": "Ты — профессиональный редактор транскрибаций звонков. Твоя задача — очистить текст и чётко разделить реплики на Менеджер/Клиент."
        }
      },
      "id": "ai-agent-0-clean",
      "name": "AI Agent 0 - Clean Transcription",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [3740, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "options": {
          "model": "gpt-4-turbo",
          "temperature": 0,
          "maxTokens": 8000,
          "topP": 1
        }
      },
      "id": "openai-model-0",
      "name": "OpenAI Model 0",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [3760, 220],
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_CREDENTIAL_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "calls_analysis",
        "matchingColumns": ["call_id"],
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "clean_transcript": "={{ $json.output }}",
            "analysis_start": true
          }
        }
      },
      "id": "supabase-save-clean-transcript",
      "name": "Save Clean Transcription",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [3960, 0],
      "credentials": {
        "supabaseApi": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Ты — эксперт по оценке работы менеджеров отдела продаж металлопроката.\n\nПроанализируй транскрибацию звонка и оцени УСТАНОВЛЕНИЕ КОНТАКТА:\n\n1. Менеджер приветствует по стандарту (\"Добрый день! Меня зовут...\")? → да/нет + цитата\n2. Менеджер уточняет имя клиента (\"Как вас зовут? Как к вам обращаться?\")? → да/нет + цитата\n3. Менеджер озвучивает цель звонка? → да/нет + цитата\n\nФормат ответа:\nВопрос 1: да/нет. Обоснование: [цитата из транскрибации]\nВопрос 2: да/нет. Обоснование: [цитата]\nВопрос 3: да/нет. Обоснование: [цитата]\n\nТранскрибация:\n{{ $('Save Clean Transcription').item.json.output }}",
        "options": {
          "systemMessage": "Ты — эксперт по оценке работы менеджеров продаж металлопроката. Анализируй строго по критериям."
        }
      },
      "id": "ai-agent-1-part1",
      "name": "AI Agent 1 - Manager Part 1",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [4180, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "options": {
          "model": "gpt-4-turbo",
          "temperature": 0,
          "maxTokens": 4000
        }
      },
      "id": "openai-model-1",
      "name": "OpenAI Model 1",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [4200, 220],
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_CREDENTIAL_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Ты — эксперт по оценке работы менеджеров отдела продаж металлопроката.\n\nПроанализируй транскрибацию и оцени КВАЛИФИКАЦИЮ И ВЫЯВЛЕНИЕ ПОТРЕБНОСТИ.\n\nЕсли звонок ПО ЗАЯВКЕ, проверь:\n1. Что планируете строить? Для каких работ? → да/нет + цитата\n2. Когда принимаете решение? → да/нет + цитата\n3. Как срочно доставка? → да/нет + цитата\n4. Нужна обработка металла? → да/нет + цитата\n5. С кем конкурируем? → да/нет + цитата\n6. Предложил сэкономить? → да/нет + цитата\n\nЕсли БЕЗ ЗАЯВКИ:\n1. Когда планируется? → да/нет + цитата\n2. Что закупаете обычно? → да/нет + цитата\n3. С кем конкурирую? → да/нет + цитата\n4. Нужна обработка? → да/нет + цитата\n5. Можно перезвонить? → да/нет + цитата\n\nТранскрибация:\n{{ $('Save Clean Transcription').item.json.output }}",
        "options": {
          "systemMessage": "Ты — эксперт по оценке. Определи тип звонка и анализируй по критериям."
        }
      },
      "id": "ai-agent-2-part2",
      "name": "AI Agent 2 - Manager Part 2",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [4400, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "options": {
          "model": "gpt-4-turbo",
          "temperature": 0,
          "maxTokens": 4000
        }
      },
      "id": "openai-model-2",
      "name": "OpenAI Model 2",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [4420, 220],
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_CREDENTIAL_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
